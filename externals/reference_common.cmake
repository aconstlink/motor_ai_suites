include_guard( GLOBAL )
include( FetchContent )

# Archive-only source population: no nested build or recursive Git history.
function( motor_reference_source name url override output )
    if( override )
        get_filename_component( source "${override}" ABSOLUTE )
    else()
        if( POLICY CMP0168 )
            cmake_policy( SET CMP0168 NEW )
        endif()
        if( POLICY CMP0135 )
            cmake_policy( SET CMP0135 NEW )
        endif()
        FetchContent_Declare( ${name} URL "${url}" SOURCE_SUBDIR _population_only )
        FetchContent_MakeAvailable( ${name} )
        FetchContent_GetProperties( ${name} SOURCE_DIR source )
    endif()
    if( NOT IS_DIRECTORY "${source}" )
        message( FATAL_ERROR "Missing reference sources: ${source}" )
    endif()
    set( ${output} "${source}" PARENT_SCOPE )
endfunction()

function( motor_reference_folders directory folder )
    get_property( targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS )
    foreach( target IN LISTS targets )
        set_target_properties( ${target} PROPERTIES FOLDER "${folder}" )
    endforeach()
    get_property( children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES )
    foreach( child IN LISTS children )
        motor_reference_folders( "${child}" "${folder}" )
    endforeach()
endfunction()
